; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ethereal Tales"
config/description="Dig, build and fight your way down into the dark, carrying the only light there is."
config/version="0.1.0"
run/main_scene="res://scenes/loading.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.059, 0.043, 0.118, 1)
boot_splash/image="res://assets/brand/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
boot_splash/show_image=true
config/icon="res://icon.png"

[autoload]

Items="*res://scripts/autoload/items.gd"
Settings="*res://scripts/autoload/settings.gd"
Account="*res://scripts/autoload/account.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Game="*res://scripts/autoload/game.gd"
BeckettRuntime="*res://addons/beckett/runtime/beckett_autoload.gd"

[beckett]

effort_schema=2
dock_revealed=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/beckett/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/effekseer/plugin.cfg")

[physics]

2d/default_gravity=2600.0
3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=3
textures/default_filters/anisotropic_filtering_level=2
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.105, 0.098, 0.141, 1)

[shader_globals]

occlude_depth={
"type": "float",
"value": 0.0
}
