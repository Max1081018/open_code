<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- wgpu picks Vulkan where it can and falls back to GLES otherwise. -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false" />

    <application
        android:label="Deepdelve"
        android:allowBackup="true"
        android:isGame="true"
        android:appCategory="game">

        <activity
            android:name="com.google.androidgamesdk.GameActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode|navigation"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

            <!-- Must match the [lib] name in app/Cargo.toml: the loader looks
                 for libdeepdelve_app.so and calls its android_main. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="deepdelve_app" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
